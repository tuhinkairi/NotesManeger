{
  "info": {
    "name": "Notes API Collection",
    "description": "API collection for testing user authentication and notes management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "notes-api-collection-v1"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check if the API server is running"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('authToken', response.token);",
                  "    if (response.data && response.data.id) {",
                  "        pm.environment.set('userId', response.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"securePassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/create-user",
              "host": ["{{baseUrl}}"],
              "path": ["create-user"]
            },
            "description": "Create a new user account"
          },
          "response": []
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get-user",
              "host": ["{{baseUrl}}"],
              "path": ["get-user"]
            },
            "description": "Get authenticated user details"
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"email\": \"john.updated@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/update-user",
              "host": ["{{baseUrl}}"],
              "path": ["update-user"]
            },
            "description": "Update user information"
          },
          "response": []
        },
        {
          "name": "Update User Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newSecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/update-user",
              "host": ["{{baseUrl}}"],
              "path": ["update-user"]
            },
            "description": "Update user password"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/delete-user",
              "host": ["{{baseUrl}}"],
              "path": ["delete-user"]
            },
            "description": "Delete user account"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get-posts",
              "host": ["{{baseUrl}}"],
              "path": ["get-posts"]
            },
            "description": "Get all posts for authenticated user"
          },
          "response": []
        },
        {
          "name": "Get Posts - Filter by Recent",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get-posts?filter[orderby][filter]=recent",
              "host": ["{{baseUrl}}"],
              "path": ["get-posts"],
              "query": [
                {
                  "key": "filter[orderby][filter]",
                  "value": "recent"
                }
              ]
            },
            "description": "Get posts ordered by recent updates"
          },
          "response": []
        },
        {
          "name": "Get Posts - Filter by New",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get-posts?filter[orderby][filter]=new",
              "host": ["{{baseUrl}}"],
              "path": ["get-posts"],
              "query": [
                {
                  "key": "filter[orderby][filter]",
                  "value": "new"
                }
              ]
            },
            "description": "Get posts ordered by newest first"
          },
          "response": []
        },
        {
          "name": "Get Posts - Filter by Old",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get-posts?filter[orderby][filter]=old",
              "host": ["{{baseUrl}}"],
              "path": ["get-posts"],
              "query": [
                {
                  "key": "filter[orderby][filter]",
                  "value": "old"
                }
              ]
            },
            "description": "Get posts ordered by oldest first"
          },
          "response": []
        },
        {
          "name": "Get Posts - Search by Title/Content",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get-posts?filter[search]=test",
              "host": ["{{baseUrl}}"],
              "path": ["get-posts"],
              "query": [
                {
                  "key": "filter[search]",
                  "value": "test"
                }
              ]
            },
            "description": "Search posts by title or content"
          },
          "response": []
        },
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.id) {",
                  "        pm.environment.set('postId', response.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Note\",\n  \"content\": \"This is the content of my first note. It contains important information.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/create-posts",
              "host": ["{{baseUrl}}"],
              "path": ["create-posts"]
            },
            "description": "Create a new post (Note: no auth required based on routes)"
          },
          "response": []
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Note Title\",\n  \"content\": \"This is the updated content of my note.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/update-posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["update-posts", "{{postId}}"]
            },
            "description": "Update an existing post"
          },
          "response": []
        },
        {
          "name": "Update Post - Title Only",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Title Only\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/update-posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["update-posts", "{{postId}}"]
            },
            "description": "Update only the post title"
          },
          "response": []
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/delete-posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["delete-posts", "{{postId}}"]
            },
            "description": "Delete a post"
          },
          "response": []
        }
      ]
    },
